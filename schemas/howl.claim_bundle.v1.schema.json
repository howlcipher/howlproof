{
  "$defs": {
    "AcquisitionPointer": {
      "additionalProperties": false,
      "description": "Points at a HowlProof acquisition record. A pointer is a claim; Proof verifies it\nagainst the operator's acquisition store, and Dream never treats it as proof.",
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "id": {
          "pattern": "^acq-[0-9a-f]{16}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "content_sha256"
      ],
      "title": "AcquisitionPointer",
      "type": "object"
    },
    "BundleAuthorship": {
      "additionalProperties": false,
      "description": "Authorship attribution for a claim bundle: who authored the underlying ideas.",
      "properties": {
        "component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component"
        },
        "kind": {
          "enum": [
            "EXTERNAL_AUTHORED",
            "MODEL_GENERATED",
            "MOCK",
            "SYNTHETIC_FIXTURE",
            "UNKNOWN"
          ],
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BundleAuthorship",
      "type": "object"
    },
    "BundleCandidate": {
      "additionalProperties": false,
      "description": "Candidate identity and snapshot metadata inside a claim bundle.",
      "properties": {
        "candidate_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "objective": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Objective"
        },
        "parent_request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Request Id"
        },
        "source_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Run Id"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "trust": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trust"
        }
      },
      "required": [
        "candidate_id"
      ],
      "title": "BundleCandidate",
      "type": "object"
    },
    "BundleClaim": {
      "additionalProperties": false,
      "description": "An individual research claim evaluated by HowlProof: howl.claim_bundle/v1.",
      "properties": {
        "assumption": {
          "default": false,
          "title": "Assumption",
          "type": "boolean"
        },
        "category": {
          "enum": [
            "EMPIRICAL",
            "TECHNICAL",
            "HYPOTHESIS",
            "VALUE_JUDGMENT"
          ],
          "title": "Category",
          "type": "string"
        },
        "category_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category Basis"
        },
        "check": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Check"
        },
        "checked_proposition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked Proposition"
        },
        "claim_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "falsification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Falsification"
        },
        "falsification_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Falsification Basis"
        },
        "origin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        },
        "scope": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "source_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Kind"
        },
        "subject_terms": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Terms"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "verification_plan": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Plan"
        }
      },
      "required": [
        "claim_id",
        "text",
        "category"
      ],
      "title": "BundleClaim",
      "type": "object"
    },
    "BundleEvidenceEntry": {
      "additionalProperties": false,
      "description": "Evidence entry metadata inside a claim bundle pointing to an evidence file.",
      "properties": {
        "acquisition": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcquisitionPointer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "independent": {
          "default": false,
          "title": "Independent",
          "type": "boolean"
        },
        "methodology_quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Methodology Quote"
        },
        "path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "produced_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Produced By"
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "represents_observed_reality": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Represents Observed Reality"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        },
        "source_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Type"
        }
      },
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "title": "BundleEvidenceEntry",
      "type": "object"
    },
    "BundleLineage": {
      "additionalProperties": false,
      "description": "Lineage metadata recorded when exporting a claim bundle.",
      "properties": {
        "candidate_created_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Created At"
        },
        "candidate_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Sha256"
        },
        "exported_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exported By"
        },
        "exporter_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exporter Version"
        }
      },
      "title": "BundleLineage",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/howlcipher/howldream/main/schemas/howl.claim_bundle.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Standardized claim bundle envelope: howl.claim_bundle/v1.",
  "properties": {
    "authorship": {
      "$ref": "#/$defs/BundleAuthorship"
    },
    "candidate": {
      "$ref": "#/$defs/BundleCandidate"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/BundleClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/BundleEvidenceEntry"
      },
      "title": "Evidence",
      "type": "array"
    },
    "lineage": {
      "$ref": "#/$defs/BundleLineage"
    },
    "schema": {
      "const": "howl.claim_bundle/v1",
      "title": "Schema",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "candidate",
    "authorship"
  ],
  "title": "Howl Ecosystem Claim Bundle (howl.claim_bundle/v1)",
  "type": "object"
}
